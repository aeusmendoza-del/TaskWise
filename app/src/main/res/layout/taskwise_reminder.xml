<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reminderRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFAFCFF"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    android:tint="@null"
                    android:contentDescription="Back to Home" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Reminders"
                    android:textColor="#23344A"
                    android:textSize="27sp"
                    android:textStyle="bold" />
                <ImageButton
                    android:id="@+id/calendarPickerButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_calendar"
                    android:tint="@null"
                    android:contentDescription="Filter by date" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="A clear plan for what’s next."
                android:textColor="#6C7D8E"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/featuredReminderCard"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_summary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">
                <ImageView
                    android:id="@+id/featuredReminderIcon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_reminder_bell"
                    android:contentDescription="Reminder bell" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NEXT UP"
                        android:textColor="#319F98"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/featuredReminderTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="No upcoming reminders"
                        android:textColor="#273A4D"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                    <TextView
                        android:id="@+id/featuredReminderDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Add a reminder to get started"
                        android:textColor="#718294"
                        android:textSize="11sp"
                        android:maxLines="2" />
                </LinearLayout>
                <ImageButton
                    android:id="@+id/featuredNotificationButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_feature_bell"
                    android:padding="7dp"
                    android:src="@drawable/ic_reminder_bell"
                    android:contentDescription="Toggle next reminder alert" />
            </LinearLayout>

            <TextView
                android:id="@+id/newReminderSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="10dp"
                android:padding="12dp"
                android:background="@drawable/bg_home_teal"
                android:textColor="#26364A"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/reminderSectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Your reminders"
                    android:textColor="#425466"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/viewAllReminders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="View all  ›"
                    android:textColor="#3998B4"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reminderListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/addReminderCard"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_add_reminder"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">
                <ImageButton
                    android:id="@+id/addReminderImageButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="#42C9C2"
                    android:padding="9dp"
                    android:src="@drawable/ic_add"
                    android:contentDescription="Add a new reminder" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add a reminder"
                        android:textColor="#269E9A"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Choose a date and notification time"
                        android:textColor="#7F909D"
                        android:textSize="11sp" />
                </LinearLayout>
                <ImageButton
                    android:id="@+id/addReminderArrow"
                    android:layout_width="34dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@null"
                    android:contentDescription="Create reminder" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_navigation" />
</LinearLayout>
