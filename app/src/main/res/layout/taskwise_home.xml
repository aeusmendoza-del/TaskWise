<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFAFCFF"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome back,"
                        android:textColor="#607080"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/homeUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-2dp"
                        android:text="Student!"
                        android:textColor="#2BC8C2"
                        android:textSize="31sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="What would you like to do today?"
                        android:textColor="#607080"
                        android:textSize="13sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="112dp"
                    android:layout_height="118dp"
                    android:src="@drawable/ic_task_checklist"
                    android:scaleType="fitCenter"
                    android:contentDescription="Task checklist illustration" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeTodayCard"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_summary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_task_calendar"
                    android:contentDescription="Today" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/homeTodaySummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your day, at a glance"
                        android:textColor="#233B4D"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/homeTodayDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Tap to view your tasks"
                        android:textColor="#64788A"
                        android:textSize="11sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="Open tasks" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/checklistCard"
                    android:layout_width="0dp"
                    android:layout_height="244dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_home_teal"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="10dp">
                    <ImageButton
                        android:id="@+id/btnChecklistImage"
                        android:layout_width="match_parent"
                        android:layout_height="125dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_task_checklist"
                        android:scaleType="fitCenter"
                    android:tint="@null"
                        android:contentDescription="Open Checklist" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Checklist"
                        android:textColor="#253548"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="View and manage\nyour tasks"
                        android:textAlignment="center"
                        android:textColor="#667686"
                        android:textSize="12sp" />
                    <ImageButton
                        android:id="@+id/btnChecklistArrow"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_arrow_teal"
                        android:padding="5dp"
                        android:src="@drawable/ic_arrow_right"
                        android:scaleType="fitCenter"
                    android:tint="@null"
                        android:contentDescription="Open Checklist" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/deadlineCard"
                    android:layout_width="0dp"
                    android:layout_height="244dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_home_purple"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="10dp">
                    <ImageButton
                        android:id="@+id/btnDeadlineImage"
                        android:layout_width="match_parent"
                        android:layout_height="125dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_task_deadline"
                        android:scaleType="fitCenter"
                    android:tint="@null"
                        android:contentDescription="Open Deadline" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deadline"
                        android:textColor="#253548"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Set and track\nyour deadlines"
                        android:textAlignment="center"
                        android:textColor="#667686"
                        android:textSize="12sp" />
                    <ImageButton
                        android:id="@+id/btnDeadlineArrow"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_arrow_purple"
                        android:padding="5dp"
                        android:src="@drawable/ic_arrow_right"
                        android:scaleType="fitCenter"
                    android:tint="@null"
                        android:contentDescription="Open Deadline" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/notebookCard"
                    android:layout_width="0dp"
                    android:layout_height="244dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_home_pink"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="10dp">
                    <ImageButton
                        android:id="@+id/btnNotebookImage"
                        android:layout_width="match_parent"
                        android:layout_height="125dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_task_notebook"
                        android:scaleType="fitCenter"
                    android:tint="@null"
                        android:contentDescription="Open Notebook" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notebook"
                        android:textColor="#253548"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Save notes and\nimportant ideas"
                        android:textAlignment="center"
                        android:textColor="#667686"
                        android:textSize="12sp" />
                    <ImageButton
                        android:id="@+id/btnNotebookArrow"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_arrow_pink"
                        android:padding="5dp"
                        android:src="@drawable/ic_arrow_right"
                        android:scaleType="fitCenter"
                    android:tint="@null"
                        android:contentDescription="Open Notebook" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/calendarCard"
                    android:layout_width="0dp"
                    android:layout_height="244dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_home_blue"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="10dp">
                    <ImageButton
                        android:id="@+id/btnCalendarImage"
                        android:layout_width="match_parent"
                        android:layout_height="125dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_task_calendar"
                        android:scaleType="fitCenter"
                    android:tint="@null"
                        android:contentDescription="Open Calendar" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calendar"
                        android:textColor="#253548"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="View your schedule\nand events"
                        android:textAlignment="center"
                        android:textColor="#667686"
                        android:textSize="12sp" />
                    <ImageButton
                        android:id="@+id/btnCalendarArrow"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_arrow_blue"
                        android:padding="5dp"
                        android:src="@drawable/ic_arrow_right"
                        android:scaleType="fitCenter"
                    android:tint="@null"
                        android:contentDescription="Open Calendar" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_navigation" />
</LinearLayout>
