<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/deadlineRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFAFCFF"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/deadlineBackButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    android:tint="@null"
                    android:contentDescription="Back to Home" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Deadlines"
                    android:textColor="#24364A"
                    android:textSize="25sp"
                    android:textStyle="bold" />
                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp">
                    <ImageButton
                        android:id="@+id/deadlineNotificationButton"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_reminder_bell"
                        android:contentDescription="Open reminders" />
                    <TextView
                        android:id="@+id/deadlineReminderBadge"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="top|end"
                        android:background="#FFE84F63"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#FFFFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="See what’s due and keep your next steps clear."
                android:textColor="#6C7D8E"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_summary"
                android:orientation="vertical"
                android:padding="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_task_checklist"
                        android:contentDescription="Task progress" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your task overview"
                            android:textColor="#26364A"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/deadlineTaskSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0 active  ·  0 due today"
                            android:textColor="#667686"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/deadlineProgressLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#2D9A93"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/deadlineProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="#E3EBEF"
                    android:progressTint="#2FAFA7" />
            </LinearLayout>

            <EditText
                android:id="@+id/taskSearchInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_input"
                android:hint="Search tasks or subjects"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#19324B"
                android:textColorHint="#8795A5"
                android:inputType="text" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/filterAll"
                        android:layout_width="82dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_tab_selected"
                        android:gravity="center"
                        android:text="All"
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/filterOverdue"
                        android:layout_width="86dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_tab_unselected"
                        android:gravity="center"
                        android:text="Overdue"
                        android:textColor="#536477"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/filterDueToday"
                        android:layout_width="94dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_tab_unselected"
                        android:gravity="center"
                        android:text="Due today"
                        android:textColor="#536477"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/filterUpcoming"
                        android:layout_width="92dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_tab_unselected"
                        android:gravity="center"
                        android:text="Upcoming"
                        android:textColor="#536477"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/filterCompleted"
                        android:layout_width="98dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_tab_unselected"
                        android:gravity="center"
                        android:text="Completed"
                        android:textColor="#536477"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/deadlineListTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="2dp"
                android:text="Your tasks"
                android:textColor="#425466"
                android:textSize="15sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/deadlineTaskList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/addNewTaskCard"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_add_task"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <ImageButton
                    android:id="@+id/addNewTaskButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="#438BDD"
                    android:padding="9dp"
                    android:src="@drawable/ic_add"
                    android:contentDescription="Add new task" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add a task"
                        android:textColor="#347AB8"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Choose a subject, priority, and due date"
                        android:textColor="#718092"
                        android:textSize="11sp" />
                </LinearLayout>
                <ImageButton
                    android:id="@+id/addNewTaskArrow"
                    android:layout_width="34dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@null"
                    android:contentDescription="Create a task" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/deadlineStudySearchCard"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_summary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_resource_search"
                    android:contentDescription="Study Search" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Need help with a task? Search study resources"
                    android:textColor="#2F7886"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <ImageButton
                    android:layout_width="30dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@null"
                    android:contentDescription="Open Study Search" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/bottom_navigation" />
</LinearLayout>
