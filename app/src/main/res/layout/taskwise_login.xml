<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loginScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="10dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="285dp">
            <ImageView
                android:id="@+id/loginLogo"
                android:layout_width="205dp"
                android:layout_height="195dp"
                android:layout_gravity="center"
                android:layout_marginTop="26dp"
                android:src="@drawable/ic_taskwise_mark"
                android:scaleType="fitCenter"
                android:contentDescription="TaskWise checkmark technology logo" />
        </FrameLayout>

        <TextView
            android:id="@+id/loginWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:text="TASKWISE"
            android:textColor="#258E91"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="10dp"
                    android:src="@drawable/ic_user"
                    android:contentDescription="Username icon" />
                <EditText
                    android:id="@+id/usernameInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:hint="Username"
                    android:textColor="#26364A"
                    android:textColorHint="#8997A6"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:inputType="textPersonName"
                    android:autofillHints="username" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="10dp"
                    android:src="@drawable/ic_email"
                    android:contentDescription="Email icon" />
                <EditText
                    android:id="@+id/emailInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:hint="Email"
                    android:textColor="#26364A"
                    android:textColorHint="#8997A6"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="10dp"
                    android:src="@drawable/ic_lock"
                    android:contentDescription="Password icon" />
                <EditText
                    android:id="@+id/passwordInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:hint="Password"
                    android:textColor="#26364A"
                    android:textColorHint="#8997A6"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:inputType="textPassword"
                    android:autofillHints="password" />
            </LinearLayout>

            <Button
                android:id="@+id/loginButton"
                android:layout_width="155dp"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_primary_button"
                android:backgroundTint="@null"
                android:elevation="2dp"
                android:text="Log in"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/forgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:text="Forgot Password"
                android:textColor="#46576A"
                android:textSize="12sp"
                android:padding="4dp" />

            <TextView
                android:id="@+id/createAccountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="6dp"
                android:text="Don't Have an Account?"
                android:textColor="#4F5D6B"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Plan smarter. Study with focus."
                android:textColor="#718294"
                android:textSize="12sp" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
